<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Docker image running, spoken to as a client would (technical spec, section 8). No reference to the code: the
       only way in is the MCP endpoint of the container. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\manuals\**\*.pdf" Link="fixtures\manuals\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
