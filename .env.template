# Copy this file to `.env` (same folder as docker-compose.yml) and set the real values. `.env` is git-ignored: never commit it.
#   Copy-Item .env.template .env
# In a stack editor such as Portainer's, set the same variables in its "Environment variables" section instead.

# --- Required ---------------------------------------------------------------------------------------------------------
# Version of the image to run: `latest` (the newest stable one; update with `docker compose pull && docker compose up -d`)
# or an exact version such as 0.1.0. A pre-release needs its exact version. Read CHANGELOG.md before updating.
TINKER_VERSION=latest

# --- Optional (these are the defaults) --------------------------------------------------------------------------------
# Folder of the database, on a LOCAL disk of the host (not NFS or SMB). The container must be able to write the folder and
# the files in it, through its user or one of its groups (README, "Permissions").
TINKER_DATA=./data

# Folder with your PDF manuals. It is mounted read-only.
TINKER_MANUALS=./manuals

# Port Tinker listens on, on this machine.
TINKER_PORT=7843

# User id and main group id the container runs as. The groups a user has on the host do not reach the container.
TINKER_UID=1000
TINKER_GID=1000

# One more group id for the container, the one that can read the manuals (`getent group <name>`). Unset: TINKER_GID only.
# TINKER_MANUALS_GID=1005

TZ=Europe/Madrid

# Tuning of the model that reads the manuals. A bigger batch uses more memory; 0 threads lets it use the CPU as it sees fit
# (lower it to leave CPU for the rest of the NAS).
TINKER_EMBEDDING_BATCH_SIZE=4
TINKER_EMBEDDING_THREADS=0

# Where to send logs and traces (OpenTelemetry); empty sends nothing. For Seq: http://seq:5341/ingest/otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://seq:5341/ingest/otlp
