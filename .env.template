# Copy this file to `.env` (same folder as docker-compose.yml) and set the real values. `.env` is git-ignored: never commit it.
#   Copy-Item .env.template .env
# In a stack editor such as Portainer's, set the same variables in its "Environment variables" section instead.

# --- Required ---------------------------------------------------------------------------------------------------------
# Version of the image to run: an exact version, so updates happen on purpose (see CHANGELOG.md). `latest` is the newest
# stable one; a pre-release needs its exact version.
TINKER_VERSION=0.1.0

# --- Optional (these are the defaults) --------------------------------------------------------------------------------
# Folder of the database, on a LOCAL disk of the host (not NFS or SMB), writable by TINKER_UID:TINKER_GID.
TINKER_DATA=./data

# Folder with your PDF manuals. It is mounted read-only.
TINKER_MANUALS=./manuals

# Port Tinker listens on, on this machine.
TINKER_PORT=7843

# User and group the container runs as: the owner of the data folder (`id -u` and `id -g`).
TINKER_UID=1000
TINKER_GID=1000

TZ=Europe/Madrid

# Where to send logs and traces (OpenTelemetry); empty sends nothing. For Seq: http://seq:5341/ingest/otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://seq:5341/ingest/otlp
