<Project>
  <!-- The version of every NuGet package is written here, once. The projects reference a package without a version.
       Versions are fixed (no ranges), so a build is reproducible and Dependabot can propose each update.
       The packages of the .NET platform (Microsoft.Extensions.*, Microsoft.AspNetCore.*, Microsoft.Data.Sqlite) are 11.x
       for .NET 11; their next major version waits for the move to the next .NET (technical spec, section 8). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
